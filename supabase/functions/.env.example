# Secrets for edge functions: `npx supabase secrets set --env-file supabase/functions/.env`
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_DEFAULT_COUNTRY=GB
# Your platform's cut of each card payment (0 = none)
PLATFORM_FEE_PERCENT=0
# Where Stripe may redirect back to (comma-separated prefixes)
ALLOWED_RETURN_URLS=golfapp://,http://localhost:8081,https://your-web-app.example
